# ==========================================
# KRAMA OS — Production Environment Template
# ==========================================

# Application Port
PORT=3000
WEB_PORT=8080
# Keep local access on loopback; use your TLS ingress for public deployments.
WEB_BIND_ADDRESS=127.0.0.1

# Environment Mode (development | production | test)
NODE_ENV=production

# Database credentials (production Compose keeps storage on its internal network)
POSTGRES_USER=krama_user
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_DB=krama_os

# Full Database Connection URL (PostgreSQL)
# Format for Docker internal network:
# Keep its user/password/database aligned with POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
DATABASE_URL=postgresql://krama_user:replace_with_a_unique_local_password@db:5432/krama_os?schema=public

# Redis credentials (Queue broker for BullMQ)
REDIS_PASSWORD=replace_with_a_different_local_password
# Keep the password aligned with REDIS_PASSWORD.
REDIS_URL=redis://:replace_with_a_different_local_password@redis:6379

# Authentication JWT Secret (MUST be changed to a random 48+ character hex/base64 string in production)
# Generate one via terminal: openssl rand -base64 48
JWT_SECRET=

# Optional trusted reverse-proxy IPs/CIDRs, comma separated. Empty for direct access.
# Production Compose sets this for its internal Nginx proxy and does not publish the API port.
TRUST_PROXY_CIDRS=
# Change both together if this Docker subnet overlaps an existing network.
KRAMA_DOCKER_SUBNET=172.30.0.0/24
KRAMA_PROXY_IP=172.30.0.10

# Auth rate limits (per IP, per 15 min window). Secure defaults apply if unset.
# Raise these for E2E/CI runs that perform many auth calls.
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30

# AI Engine API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Holiday provider (optional). When set, the planner uses Calendarific, which
# supports sub-national/regional holidays. Without it, it falls back to the
# national-only Nager.Date API (no key required).
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# CORS Allowed Origins (Comma-separated URLs of deployed frontend)
CORS_ORIGIN=http://localhost,http://localhost:8080
# Deployed frontend origin (also added to the CORS allow-list by the server)
FRONTEND_URL=http://localhost

# AI request rate limit (requests per minute per workspace; defaults to 20 if unset)
AI_RATE_LIMIT_PER_MIN=20

# Cloudflare R2 storage (optional; required for image/wallpaper uploads).
# Fill these in private apps/server/.env for host development and root .env for Docker.
# Do not put real keys in this tracked sample file.
# R2 dashboard > Overview: copy your Cloudflare Account ID.
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens: use Object Read & Write scoped to your bucket.
# Copy the S3 Access Key ID and Secret Access Key, not the Cloudflare bearer token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Exact name of the bucket you already created.
R2_BUCKET_NAME=
# No domain needed for personal/development use: bucket > Settings > Public
# Development URL. If you choose to enable it, copy https://pub-....r2.dev here.
# This URL makes uploaded images publicly accessible; use a bucket for public images.
# Leave blank to keep uploads unavailable until storage is configured.
R2_PUBLIC_URL=
# Official setup references:
# https://developers.cloudflare.com/r2/api/tokens/
# https://developers.cloudflare.com/r2/buckets/public-buckets/

# Unsplash access key (focus-mode wallpapers; feature degrades gracefully if unset)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
