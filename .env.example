# ==========================================
# KRAMA OS — Production Environment Template
# ==========================================

# Application Port
PORT=3001

# Environment Mode (development | production | test)
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# For Docker Compose local dev: postgresql://postgres:password@localhost:5432/krama?schema=public
# For Railway / Render / Supabase: postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/krama?schema=public"

# Authentication JWT Secret (MUST be changed to a random 48+ character hex/base64 string in production)
# Generate one via terminal: openssl rand -base64 48
JWT_SECRET="krama-os-secret-jwt-key-2026"

# CORS Allowed Origins (Comma-separated URLs of deployed Vite frontend)
# Example: https://krama.vercel.app,https://my-domain.com
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
CLIENT_URL="http://localhost:5173"
