# ==========================================
# KRAMA OS — Production Environment Template
# ==========================================

# Application Port
PORT=3000
WEB_PORT=80

# Environment Mode (development | production | test)
NODE_ENV=production

# Database Credentials & Port (PostgreSQL + pgvector)
POSTGRES_USER=krama_user
POSTGRES_PASSWORD=krama_secure_password_change_me
POSTGRES_DB=krama_os
POSTGRES_PORT=5435

# Full Database Connection URL (PostgreSQL)
# Format for Docker internal network:
DATABASE_URL=postgresql://krama_user:krama_secure_password_change_me@db:5432/krama_os?schema=public

# Redis Credentials & Port (Queue broker for BullMQ)
REDIS_PASSWORD=krama_redis_secret_change_me
REDIS_PORT=6379
REDIS_URL=redis://:krama_redis_secret_change_me@redis:6379

# Authentication JWT Secret (MUST be changed to a random 48+ character hex/base64 string in production)
# Generate one via terminal: openssl rand -base64 48
JWT_SECRET=krama-os-secret-jwt-key-change-me-2026

# AI Engine API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# CORS Allowed Origins (Comma-separated URLs of deployed frontend)
CORS_ORIGIN=http://localhost,http://localhost:8080
CLIENT_URL=http://localhost
