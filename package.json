{
  "name": "krama-os",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter server test",
    "test:ui": "playwright test",
    "test:e2e": "playwright test --config playwright.integration.config.ts",
    "holidays:sync": "pnpm --filter server holidays:sync"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "typescript": "^5.5.3"
  }
}
