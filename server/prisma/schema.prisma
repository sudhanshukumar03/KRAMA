generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaces    Space[]
}

model Space {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       Page[]
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Page {
  id              String    @id @default(uuid())
  title           String
  icon            String?
  blocks          Json?     // Tiptap rich content
  parentPageId    String?
  parentPage      Page?     @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages      Page[]    @relation("PageHierarchy")
  tags            String[]
  linkedProjectId String?
  linkedProject   Project?  @relation("ProjectDocs", fields: [linkedProjectId], references: [id])
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  Resource Resource[]
}

model Goal {
  id             String    @id @default(uuid())
  title          String
  type           String    // yearly, quarterly, monthly
  targetDate     DateTime?
  parentGoalId   String?
  parentGoal     Goal?     @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  childGoals     Goal[]    @relation("GoalHierarchy")
  progress       Float     @default(0) // progress percentage
  snapshots      GoalProgressSnapshot[]
  linkedProjects Project[] @relation("GoalProjects")
  habits         Habit[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model GoalProgressSnapshot {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      DateTime
  progress  Float    // progress % at this point in time
  createdAt DateTime @default(now())
}

model Project {
  id               String          @id @default(uuid())
  name             String
  problemStatement String?
  status           String          // idea, active, paused, shipped
  spaceId          String?         // Where it belongs logically
  space            Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  docs             Page[]          @relation("ProjectDocs")
  goalId           String?
  goal             Goal?           @relation("GoalProjects", fields: [goalId], references: [id])
  issues           Issue[]
  roadmapItems     RoadmapItem[]
  sprints          Sprint[]
  decisions        Decision[]
  learningTopics   LearningTopic[] @relation("ProjectLearningTopics")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Issue {
  id            String    @id @default(uuid())
  title         String
  description   String?
  status        String    // backlog, todo, in_progress, review, testing, done, released
  priority      String    // none, low, medium, high, urgent
  estimate      Float?    // hours or points
  assignee      String?   // simple string for single-user
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId      String?
  sprint        Sprint?   @relation(fields: [sprintId], references: [id])
  parentIssueId String?
  parentIssue   Issue?    @relation("IssueHierarchy", fields: [parentIssueId], references: [id])
  childIssues   Issue[]   @relation("IssueHierarchy")
  labels        String[]  // bug, feature, task, chore
  dueDate       DateTime?
  scheduledDate DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Sprint {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoadmapItem {
  id        String   @id @default(uuid())
  title     String
  version   String?  // version or milestone label
  order     Int      @default(0)
  status    String   // planned, in_progress, completed
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id             String    @id @default(uuid())
  name           String
  cadence        String    // daily, weekly
  streak         Int       @default(0)
  lastCompletedAt DateTime?
  linkedGoalId   String?
  linkedGoal     Goal?     @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DailyLog {
  id              String   @id @default(uuid())
  date            DateTime @unique
  wins            String[]
  blockers        String[]
  mood            String?
  energy          String?
  deepWorkMinutes Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Decision {
  id                    String   @id @default(uuid())
  title                 String
  context               String?
  reasoning             String?
  alternativesConsidered String[]
  outcome               String?
  date                  DateTime
  linkedProjectId       String?
  linkedProject         Project? @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Resource {
  id             String          @id @default(uuid())
  title          String
  type           String          // pdf, video, course, article, repo, bookmark
  url            String?
  tags           String[]
  linkedPageId   String?
  linkedPage     Page?           @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)
  linkedTopicId  String?
  linkedTopic    LearningTopic?  @relation(fields: [linkedTopicId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LearningTopic {
  id               String          @id @default(uuid())
  name             String
  category         String          // frontend, backend, dsa, genai, etc.
  progress         Float           @default(0) // progress percentage
  
  // Self-referencing many-to-many relationship for prerequisites
  prerequisites    LearningTopic[] @relation("Prerequisites")
  prerequisiteFor  LearningTopic[] @relation("Prerequisites")

  resources        Resource[]
  linkedProjects   Project[]       @relation("ProjectLearningTopics")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ApplicationEntry {
  id                 String    @id @default(uuid())
  company            String
  role               String
  status             String    // applied, oa, interview, offer, rejected
  appliedDate        DateTime
  notes              String?
  resumeVersion      String?
  portfolioLastUpdated DateTime?
  githubActivitySnapshot String? // could be JSON or string
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AutomationRule {
  id        String   @id @default(uuid())
  trigger   String   // e.g. deadline_within_X_days, status_changed_to_Y
  action    String   // e.g. raise_priority, notify
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
