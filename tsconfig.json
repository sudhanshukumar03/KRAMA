{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright*.config.ts",
    "e2e/**/*.ts",
    "scripts/media/**/*.ts",
    "scripts/verification/**/*.ts"
  ]
}
